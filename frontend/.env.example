# ============================================================
#  FileName:-     .env.example
#  Description:-  Environment variables template for WanderLux
#  Author:-       Shaik Mohammad Anas
#  Created-date:- 13-04-2026
# ============================================================

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=WanderLux
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Auth
VITE_JWT_SECRET_KEY=your_jwt_secret_here
VITE_REFRESH_TOKEN_KEY=your_refresh_token_key_here

# Google Maps (optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Payment Gateway (optional)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_here
VITE_STRIPE_PUBLIC_KEY=your_stripe_key_here

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Feature Flags
VITE_ENABLE_CHAT=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false

# Social Auth (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
