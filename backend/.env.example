# ============================================================
#  FileName:-     .env.example
#  Description:-  Environment variables template
#  Author:-       Shaik Mohammad Anas
#  Created-date:- 13-04-2026
# ============================================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=TravelAgency
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/travel_agency
MONGODB_TEST_URI=mongodb://localhost:27017/travel_agency_test

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=your_reset_secret_key_here
JWT_RESET_EXPIRES=1h
JWT_VERIFY_SECRET=your_verify_secret_key_here
JWT_VERIFY_EXPIRES=24h

# Bcrypt
BCRYPT_ROUNDS=12

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Travel Agency

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOC_TYPES=application/pdf,image/jpeg,image/png

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# Payment Gateway (example Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Logging
LOG_LEVEL=info
LOG_DIR=logs
