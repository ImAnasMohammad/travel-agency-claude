# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/travel-agency

# JWT
JWT_SECRET=wanderlux_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=wanderlux_refresh_secret_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer - use Gmail or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (optional - for payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Seed
ADMIN_EMAIL=admin@wanderlux.com
ADMIN_PASSWORD=Admin@1234

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
